{
	"name": "midijourney-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "MIDIjourney browser prototype using Pollinations UI and SDK",
	"pollinations": {
		"theme": "blue"
	},
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"core": "node scripts/build-core.mjs",
		"predev": "npm run core",
		"dev": "vite",
		"build": "npm run core && tsc --noEmit && vite build",
		"typecheck": "npm run core && tsc --noEmit",
		"test": "npm run core && node --test test/*.test.mjs",
		"preview": "vite preview"
	},
	"dependencies": {
		"@pollinations/sdk": "5.1.0-alpha.7",
		"@pollinations/ui": "file:vendor/pollinations-ui-0.1.0-alpha.1.tgz",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.13.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"esbuild": "0.28.2",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.0"
	}
}
